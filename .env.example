# Copy to .env and fill in from your Supabase project (Settings > API).
# Both are safe to expose in the client bundle — row-level security is what
# protects the data, not these values. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
